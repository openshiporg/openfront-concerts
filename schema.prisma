  scanEvent_ticket       ScanEvent[]      @relation("ScanEvent_ticket")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @default(now()) @updatedAt

  @@index([orderId])
  @@index([eventId])
  @@index([lineId])
  @@index([seatInventoryId])
  @@index([transferredFromId])
}

model ScanEvent {
  id          String    @id @default(cuid())
  gate        String    @default("")
  at          DateTime?
  result      String?   @default("admitted")
  ticket      Ticket?   @relation("ScanEvent_ticket", fields: [ticketId], references: [id])
  ticketId    String?   @map("ticket")
  event       Event?    @relation("ScanEvent_event", fields: [eventId], references: [id])
  eventId     String?   @map("event")
  scannedBy   User?     @relation("ScanEvent_scannedBy", fields: [scannedById], references: [id])
  scannedById String?   @map("scannedBy")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([ticketId])
  @@index([eventId])
  @@index([scannedById])
}

model MerchSales {
  id                String   @id @default(cuid())
  softGrossCents    Int?     @default(0)
  hardGrossCents    Int?     @default(0)
  venueSoftSplitBps Int?     @default(0)
  venueHardSplitBps Int?     @default(0)
  venueShareCents   Int?     @default(0)
  sellerFeeCents    Int?     @default(0)
  countIn           Json?
  countOut          Json?
  event             Event?   @relation("MerchSales_event", fields: [eventId], references: [id])
  eventId           String?  @map("event")
  currencyCode      String   @default("USD")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([eventId])
}

model BarSales {
  id               String   @id @default(cuid())
  grossCents       Int?     @default(0)
  promoterShareBps Int?     @default(0)
  event            Event?   @relation("BarSales_event", fields: [eventId], references: [id])
  eventId          String?  @map("event")
  currencyCode     String   @default("USD")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([eventId])
}

model Settlement {
  id                         String           @id @default(cuid())
  hash                       String           @default("")
  version                    Int?             @default(1)
  ticketGrossCents           Int?             @default(0)
  ticketFeesCents            Int?             @default(0)
  taxCents                   Int?             @default(0)
  compCount                  Int?             @default(0)
  paidCount                  Int?             @default(0)
  netBoxOfficeCents          Int?             @default(0)
  totalExpensesCents         Int?             @default(0)
  cappedExpensesCents        Int?             @default(0)
  breakevenCents             Int?             @default(0)
  splitPointCents            Int?             @default(0)
  artistGuaranteeCents       Int?             @default(0)
  artistOverageCents         Int?             @default(0)
  artistTotalCents           Int?             @default(0)
  merchVenueShareCents       Int?             @default(0)
  depositsPaidCents          Int?             @default(0)
  balanceDueArtistCents      Int?             @default(0)
  promoterNetCents           Int?             @default(0)
  computedSnapshot           Json?
  approvals                  Json?
  status                     String?          @default("draft")
  event                      Event?           @relation("Settlement_event", fields: [eventId], references: [id])
  eventId                    String?          @map("event")
  previousVersion            Settlement?      @relation("Settlement_previousVersion", fields: [previousVersionId], references: [id])
  previousVersionId          String?          @map("previousVersion")
  settlement_previousVersion Settlement[]     @relation("Settlement_previousVersion")
  settlementLine_settlement  SettlementLine[] @relation("SettlementLine_settlement")
  artistPayment_settlement   ArtistPayment[]  @relation("ArtistPayment_settlement")
  currencyCode               String           @default("USD")
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @default(now()) @updatedAt

  @@index([eventId])
  @@index([previousVersionId])
}

model SettlementLine {
  id                String      @id @default(cuid())
  label             String      @default("")
  sourceRef         String      @default("")
  reason            String      @default("")
  amountCents       Int?        @default(0)
  roundingRemainder Int?        @default(0)
  kind              String?     @default("gross")
  settlement        Settlement? @relation("SettlementLine_settlement", fields: [settlementId], references: [id])
  settlementId      String?     @map("settlement")
  approvedBy        User?       @relation("SettlementLine_approvedBy", fields: [approvedById], references: [id])
  approvedById      String?     @map("approvedBy")
  currencyCode      String      @default("USD")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @default(now()) @updatedAt

  @@index([settlementId])
  @@index([approvedById])
}

model ArtistPayment {
  id           String      @id @default(cuid())
  method       String      @default("")
  reference    String      @default("")
  amountCents  Int?        @default(0)
  kind         String?     @default("deposit")
  status       String?     @default("scheduled")
  settlement   Settlement? @relation("ArtistPayment_settlement", fields: [settlementId], references: [id])
  settlementId String?     @map("settlement")
  currencyCode String      @default("USD")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  @@index([settlementId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  action     String   @default("")
  targetList String   @default("")
  targetId   String   @default("")
  reason     String   @default("")
  requestId  String   @default("")
  before     Json?
  after      Json?
  actor      User?    @relation("AuditEvent_actor", fields: [actorId], references: [id])
  actorId    String?  @map("actor")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([actorId])
}

model StoreSettings {
  id                           String   @id @default(cuid())
  name                         String   @default("")
  refundApprovalThresholdCents Int?     @default(0)
  manager                      User?    @relation("StoreSettings_manager", fields: [managerId], references: [id])
  managerId                    String?  @map("manager")
  currencyCode                 String   @default("USD")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @default(now()) @updatedAt

  @@index([managerId])
}

model PaymentProvider {
  id                           String           @id @default(cuid())
  name                         String           @default("")
  code                         String           @unique @default("")
  isInstalled                  Boolean          @default(true)
  credentials                  Json?            @default("{}")
  metadata                     Json?            @default("{}")
  createPaymentFunction        String           @default("")
  capturePaymentFunction       String           @default("")
  refundPaymentFunction        String           @default("")
  getPaymentStatusFunction     String           @default("")
  generatePaymentLinkFunction  String           @default("")
  handleWebhookFunction        String           @default("")
  sessions                     PaymentSession[] @relation("PaymentSession_paymentProvider")
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @default(now()) @updatedAt
  from_Payment_paymentProvider Payment[]        @relation("Payment_paymentProvider")
}

model PaymentCollection {
  id                            String                            @id @default(cuid())
  description                   PaymentCollectionDescriptionType? @default(default)
  amount                        Int
  authorizedAmount              Int?                              @default(0)
  refundedAmount                Int?                              @default(0)
  metadata                      Json?
  paymentSessions               PaymentSession[]                  @relation("PaymentSession_paymentCollection")
  payments                      Payment[]                         @relation("Payment_paymentCollection")
  ticketOrder_paymentCollection TicketOrder[]                     @relation("TicketOrder_paymentCollection")
  createdAt                     DateTime                          @default(now())
  updatedAt                     DateTime                          @default(now()) @updatedAt
}

model PaymentSession {
  id                  String             @id @default(cuid())
  isSelected          Boolean            @default(false)
  isInitiated         Boolean            @default(false)
  amount              Int
  data                Json?              @default("{}")
  idempotencyKey      String             @unique @default("")
  paymentCollection   PaymentCollection? @relation("PaymentSession_paymentCollection", fields: [paymentCollectionId], references: [id])
  paymentCollectionId String?            @map("paymentCollection")
  paymentProvider     PaymentProvider?   @relation("PaymentSession_paymentProvider", fields: [paymentProviderId], references: [id])
  paymentProviderId   String?            @map("paymentProvider")
  paymentAuthorizedAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt

  @@index([paymentCollectionId])
  @@index([paymentProviderId])
}

model Payment {
  id                               String                @id @default(cuid())
  idempotencyKey                   String                @unique @default("")
  reservedAt                       DateTime?
  refundedAmount                   Int?                  @default(0)
  amount                           Int
  data                             Json?
  currencyCode                     String                @default("USD")
  status                           String                @default("pending")
  paymentMethod                    String?               @default("credit_card")
  paymentProvider                  PaymentProvider?      @relation("Payment_paymentProvider", fields: [paymentProviderId], references: [id])
  paymentProviderId                String?               @map("paymentProvider")
  providerPaymentId                String                @default("")
  cardLast4                        String                @default("")
  cardBrand                        String                @default("")
  tipAmount                        Int?                  @default(0)
  isSplitPayment                   Boolean               @default(false)
  splitPaymentIndex                Int?
  splitTotal                       Int?
  processedAt                      DateTime?
  errorMessage                     String                @default("")
  notes                            String                @default("")
  order                            TicketOrder?          @relation("Payment_order", fields: [orderId], references: [id])
  orderId                          String?               @map("order")
  paymentCollection                PaymentCollection?    @relation("Payment_paymentCollection", fields: [paymentCollectionId], references: [id])
  paymentCollectionId              String?               @map("paymentCollection")
  processedBy                      User?                 @relation("Payment_processedBy", fields: [processedById], references: [id])
  processedById                    String?               @map("processedBy")
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @default(now()) @updatedAt
  from_Refund_payment              Refund[]              @relation("Refund_payment")
  from_PaymentWebhookEvent_payment PaymentWebhookEvent[] @relation("PaymentWebhookEvent_payment")

  @@index([paymentProviderId])
  @@index([orderId])
  @@index([paymentCollectionId])
  @@index([processedById])
}

model Refund {
  id               String       @id @default(cuid())
  idempotencyKey   String       @unique @default("")
  amount           Int
  currencyCode     String       @default("")
  status           String       @default("processing")
  reason           String       @default("")
  providerRefundId String       @default("")
  providerData     Json?
  processedAt      DateTime?
  payment          Payment?     @relation("Refund_payment", fields: [paymentId], references: [id])
  paymentId        String?      @map("payment")
  order            TicketOrder? @relation("Refund_order", fields: [orderId], references: [id])
  orderId          String?      @map("order")
  requestedBy      User?        @relation("Refund_requestedBy", fields: [requestedById], references: [id])
  requestedById    String?      @map("requestedBy")
  approvedBy       User?        @relation("Refund_approvedBy", fields: [approvedById], references: [id])
  approvedById     String?      @map("approvedBy")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  @@index([paymentId])
  @@index([orderId])
  @@index([requestedById])
  @@index([approvedById])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  eventKey        String    @unique @default("")
  providerCode    String    @default("")
  providerEventId String    @default("")
  eventType       String    @default("")
  status          String?   @default("received")
  payload         Json?
  rawBody         String    @default("")
  error           String    @default("")
  attempts        Int?      @default(0)
  receivedAt      DateTime? @default(now())
  processedAt     DateTime?
  payment         Payment?  @relation("PaymentWebhookEvent_payment", fields: [paymentId], references: [id])
  paymentId       String?   @map("payment")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([providerCode])
  @@index([providerEventId])
  @@index([eventType])
  @@index([receivedAt])
  @@index([paymentId])
}

model IdempotencyKey {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique @default("")
  requestMethod  String    @default("")
  requestParams  Json?
  requestPath    String    @default("")
  responseCode   Int?
  responseBody   Json?
  recoveryPoint  String    @default("started")
  lockedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}

enum PaymentCollectionDescriptionType {
  default
  refund
}
